  "components": {
    "schemas": {
      "ChunkSettings": {
        "properties": {
          "tokenizer": {
            "type": "string",
            "const": "cl100k_base",
            "title": "Tokenizer",
            "default": "cl100k_base"
          },
          "child_target_tokens": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 64.0,
            "title": "Child Target Tokens",
            "default": 350
          },
          "child_max_tokens": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 128.0,
            "title": "Child Max Tokens",
            "default": 500
          },
          "parent_max_tokens": {
            "type": "integer",
            "maximum": 8000.0,
            "minimum": 256.0,
            "title": "Parent Max Tokens",
            "default": 1800
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ChunkSettings"
      },
      "ChunkingJob": {
        "properties": {
          "source_artifact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "title": "Source Artifact Id"
          },
          "settings": {
            "$ref": "#/components/schemas/ChunkSettings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_artifact_id"
        ],
        "title": "ChunkingJob"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IndexingJob": {
        "properties": {
          "source_artifact_ids": {
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Source Artifact Ids"
          },
          "batch_size": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Batch Size",
            "default": 2
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_artifact_ids"
        ],
        "title": "IndexingJob"
      },
      "ParsingJob": {
        "properties": {
          "source_artifact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "title": "Source Artifact Id"
          },
          "backend": {
            "type": "string",
            "enum": [
              "paddleocr",
              "dots-mocr"
            ],
            "title": "Backend",
            "default": "dots-mocr"
          },
          "enrich_visuals": {
            "type": "boolean",
            "title": "Enrich Visuals",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_artifact_id"
        ],
        "title": "ParsingJob"
      },
      "PipelineJob": {
        "properties": {
          "source_artifact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "title": "Source Artifact Id"
          },
          "dpi": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 36.0,
            "title": "Dpi",
            "default": 144
          },
          "max_pages": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Max Pages",
            "default": 200
          },
          "backend": {
            "type": "string",
            "enum": [
              "paddleocr",
              "dots-mocr"
            ],
            "title": "Backend",
            "default": "dots-mocr"
          },
          "chunk_settings": {
            "$ref": "#/components/schemas/ChunkSettings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_artifact_id"
        ],
        "title": "PipelineJob"
      },
      "PreparationJob": {
        "properties": {
          "source_artifact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "title": "Source Artifact Id"
          },
          "dpi": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 36.0,
            "title": "Dpi",
            "default": 144
          },
          "max_pages": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Max Pages",
            "default": 200
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_artifact_id"
        ],
        "title": "PreparationJob"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
