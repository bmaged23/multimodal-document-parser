# Default visual provider: Ollama Cloud, gemma4:31b. Never commit real credentials.
OLLAMA_API_KEY=
# Private service authentication; generate locally, never commit a real key.
PIPELINE_API_KEY=
PIPELINE_STORAGE=outputs/service_data

# Optional separate Qwen Cloud transport (not required for Ollama Cloud).
# Its key and endpoint must belong to the same region.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1
